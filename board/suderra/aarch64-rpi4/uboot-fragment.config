#
# Suderra OS - U-Boot config fragment of the Raspberry Pi 4 / CM4 / Revolution
# Pi Connect 4 (ADR-0007, ADR-048 DEC-18).
#
# Applied on rpi_arm64_defconfig after board/suderra/uboot/hardening.config
# (the defconfigs list both files, hardening first): this file holds only what
# is a fact of this board family, the environment storage.
#
# The environment is two raw copies on the boot disk's user area, in the gap
# between the GPT and the first partition (genimage-prod.cfg starts the boot
# partition at 1 MiB; tests/image-contracts/uboot-env-contract-test.sh compares
# these offsets with it and with package/suderra-rauc-config/fw_env.config).
# It is not a file on the FAT any more: the FAT is mounted read-only except
# while RAUC installs (DEC-18.4), and a FAT file cannot be redundant (env/fat.c
# has no redundancy), so a power cut while the boot counters are written could
# leave no valid environment. The two copies are CRC-checked and carry a
# flag byte; U-Boot loads the valid one with the newer flag and writes the
# other. The symbol is SYS_REDUNDAND_ENVIRONMENT in U-Boot 2025.04 (env/Kconfig:
# 466), not ENV_REDUNDANT.
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_ENV_SIZE=0x4000
CONFIG_ENV_OFFSET=0x60000
CONFIG_ENV_OFFSET_REDUND=0x80000

# Drivers of the devices the production boot does not use. The boot reads one
# eMMC or SD device; there is no network, USB, PCIe or display in U-Boot (the
# kernel has its own drivers and device tree). Fewer drivers is fewer bytes an
# attacker-controlled device can reach before the kernel runs.
# CONFIG_BCMGENET is not set
# CONFIG_PCI is not set
# CONFIG_VIDEO is not set
