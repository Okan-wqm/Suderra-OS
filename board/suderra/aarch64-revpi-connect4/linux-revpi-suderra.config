#
# Suderra OS - kernel fragment of the Revolution Pi Connect 4 (ADR-048 DEC-8.6)
#
# Applied on top of KUNBUS's own revpi-v8_defconfig (BR2_LINUX_KERNEL_DEFCONFIG
# = "revpi-v8", kernel revpi-6.12 @ v6.12.91-revpi0, pinned in the defconfigs),
# followed by board/suderra/aarch64-rpi4/linux-rpi4-hardening.config (the arm64
# hardening shared with the other BCM2711 boards) and, in production only, by
# linux-revpi-suderra-prod.config. The KUNBUS defconfig is a distribution kernel:
# nftables, conntrack, the TPM driver, dm-crypt and the SPI/I2C masters are
# modules in it, and dm-verity and the lockdown LSM are absent.
# Every symbol below is something an image of this board needs at boot or
# enforces; scripts/ci/check-kernel-config.py derives the same set from what
# the image runs and checks it, in the fragments on every PR and on the resolved
# .config of every image build.
#
# One symbol per line, "CONFIG_X=y" or "# CONFIG_X is not set", no trailing
# comment (the checker rejects both).
#

# === Real-time kernel of the Connect 4 (piControl's cyclic exchange) ===
CONFIG_PREEMPT_RT=y

# === Boot path: the FIT carries a gzip dm-verity initramfs ===
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y

# === LUKS2 /data (aes-xts-plain64, AF_ALG keyslot encryption) ===
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# === Firewall: nftables.conf and nftables.provisioning.conf ===
# IPV6 is a module in the KUNBUS defconfig, and while it is, nft_reject depends
# on !NF_TABLES_INET || (IPV6!=m || m) caps NFT_REJECT and NFT_REJECT_INET at m:
# the "=y" below would resolve to m. The sets the rulesets use (a hash set for
# the per-source meter) are part of nf_tables itself since 6.2, no symbol.
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NF_LOG_SYSLOG=y

# === Agent sandbox (unit-directives.json): seccomp and the cgroup device filter ===
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# === TPM 2.0: Infineon SLB9670 on SPI1 (the revpi-connect4 overlay's tpm@0) ===
# SPI1 is the BCM2711 auxiliary SPI, so its master driver is built in too: the
# TPM must be there before suderra-data-unlock seals and opens /data.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS_SPI=y
CONFIG_SPI=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_BCM2835AUX=y

# === I2C1 devices of the overlay: PCF2129 RTC (0x51), PCAL6416/6524 expanders ===
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y

# === RTC: NXP PCF2129 (CR2032 backed), hctosys at boot, systohc for chrony ===
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF2127=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y

# === Hardware watchdogs: the BCM2711 PM watchdog and the PCF2129's ===
# (PID1 owns the one the board's system.conf.d names; NOWAYOUT is set with it.)
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# === Serial: UART5 RS485, UART3 PiBridge, UART1 (mini-UART) console ===
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_MUX_PIBRIDGE=y

# === Status LEDs: 15 RGB LEDs on the PCAL expanders, driven by piControl triggers ===
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y

# === On-board Ethernet ===
CONFIG_BCMGENET=y

# === Hardening that every Suderra OS kernel carries ===
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_DEVMEM=y

# No baked-in command line: the KUNBUS default names a debugger console and a
# root device. The bootloader's command line (cmdline.txt, the FIT's bootargs)
# is the only one.
CONFIG_CMDLINE=""
