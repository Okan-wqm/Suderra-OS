# Suderra OS - production U-Boot hardening (ADR-048 DEC-18; EI-013, EI-034,
# EI-035, EI-036). Board independent: merged after the board's own defconfig by
# every production U-Boot, and by the QEMU build that tests the boot chain
# (tests/qemu/arm-fit-signature-boot.sh), so what the test runs is what ships.
#
# scripts/ci/check-uboot-config.py holds the policy these lines implement. It
# checks the files in "static" mode on every PR and the resolved .config of the
# U-Boot Buildroot built in "resolved" mode, because a line here is not a
# guarantee: Kconfig drops an assignment whose dependency is gone and keeps a
# value the base defconfig expanded before this file was merged (the resolved
# .config of the previous fragment kept CONFIG_LEGACY_IMAGE_FORMAT=y).
#
# Every line is a plain CONFIG_<NAME>=<value> or "# CONFIG_<NAME> is not set"
# line; the reason of a block is in the comment above it.

# Signed boot. FIT_SIGNATURE enforces the configuration signature the key in
# the control FDT names (required = "conf"). The legacy uImage and script
# formats carry no signature and bootm accepts them next to a FIT, so a
# production U-Boot must not know them (the base defconfig expands
# LEGACY_IMAGE_FORMAT=y before FIT_SIGNATURE is merged, hence the explicit
# line). FIT_BEST_MATCH picks the configuration whose compatible matches the
# running board, so one FIT boots Pi 4B, CM4 and CM4 IO board.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_VERBOSE=y
CONFIG_FIT_BEST_MATCH=y
CONFIG_RSA=y
CONFIG_SHA256=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_ANDROID_BOOT_IMAGE is not set

# Control FDT: the device tree the Pi firmware built and passed to U-Boot
# (OF_BOARD). It is U-Boot's own hardware description on every board of the
# family (the tree compiled into U-Boot is the Pi 4B's alone), and it must carry
# the /signature node, which the build puts into the board DTBs the firmware
# loads. A control FDT without that node makes U-Boot accept ANY FIT
# (boot/image-fit-sig.c), so the compiled-in bootcmd refuses to boot unless the
# node is there (board/suderra/uboot/suderra.env).
CONFIG_OF_CONTROL=y
CONFIG_OF_BOARD=y

# Environment. The compiled-in default environment is the only source of
# bootcmd, bootargs and every other variable but the RAUC boot counters:
# ENV_WRITEABLE_LIST makes env_load() start from the default environment and
# lets the stored one overwrite only the variables whose flag is "w"
# (CFG_ENV_FLAGS_LIST_STATIC, set by the patch in board/suderra/uboot/patches).
# The default environment is one reviewed file (USE_DEFAULT_ENV_FILE), not the
# board's .env on top of Kconfig defaults.
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_ENV_WRITEABLE_LIST=y
CONFIG_ENV_APPEND=y
CONFIG_ENV_ACCESS_IGNORE_FORCE=y
CONFIG_USE_DEFAULT_ENV_FILE=y
# CONFIG_ENV_IMPORT_FDT is not set
# CONFIG_USE_BOOTARGS is not set
# CONFIG_BOOTARGS_SUBST is not set
# CONFIG_SILENT_CONSOLE is not set
# CONFIG_BOOTCOUNT_LIMIT is not set

# Autoboot. -2 boots at once and never looks at the console (-1 DISABLES
# autoboot and stops at the prompt). AUTOBOOT_KEYED without
# AUTOBOOT_KEYED_CTRLC locks Ctrl-C while bootcmd runs. The console input is
# the null device (stdin in the default environment), so no key reaches U-Boot
# even if bootcmd ever returned.
CONFIG_BOOTDELAY=-2
CONFIG_AUTOBOOT_KEYED=y
# CONFIG_AUTOBOOT_KEYED_CTRLC is not set
CONFIG_SYS_DEVICE_NULLDEV=y
# CONFIG_USE_PREBOOT is not set

# Boot paths. Signature verification belongs to bootm's FIT path alone; booti,
# bootefi, sysboot, PXE, DHCP/TFTP and boot from USB all start an unverified
# image, and distro boot (BOOTSTD) walks every one of them. Only the compiled-in
# bootcmd boots, from the boot partition of the device U-Boot runs from.
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_SYSBOOT is not set
# CONFIG_CMD_PXE is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_TFTPBOOT is not set
CONFIG_NO_NET=y
# CONFIG_NET is not set
# CONFIG_NET_LWIP is not set
# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU is not set
# CONFIG_CMD_ELF is not set
# CONFIG_CMD_GO is not set
# CONFIG_CMD_LOADB is not set
# CONFIG_CMD_LOADS is not set

# What the compiled-in bootcmd itself runs.
CONFIG_CMD_BOOTM=y
CONFIG_CMD_FDT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_ECHO=y
CONFIG_CMD_PART=y
CONFIG_CMD_RUN=y
CONFIG_CMD_SAVEENV=y
