# Suderra OS - the QEMU arm64 U-Boot that runs the production boot logic
# (tests/qemu/arm-fit-signature-boot.sh, scripts/ci/uboot-build.sh qemu).
#
# Merged on qemu_arm64_defconfig after board/suderra/uboot/hardening.config, the
# fragment every production U-Boot merges, so the policy, the compiled-in
# bootcmd and the environment rules the test exercises are the shipped ones. The
# only differences from a production build are facts of the machine:
#  - the environment is a redundant pair at the start of the machine's second
#    pflash bank, one copy per 128 KiB flash sector (flinfo), 16 KiB each like the
#    two raw copies on the Pi's eMMC/SD card;
#  - U-Boot's CFI buffer writes time out against QEMU's flash model (stock
#    qemu_arm64 fails saveenv the same way), so words are written one at a time;
#  - the default environment is the production file with its two per-board values
#    (fitaddr, suderra_bootdev) replaced.
# scripts/ci/check-uboot-config.py checks this fragment's list with the
# "qemu-test" profile.
CONFIG_ENV_IS_IN_FLASH=y
CONFIG_ENV_ADDR=0x4000000
CONFIG_ENV_ADDR_REDUND=0x4020000
CONFIG_ENV_SIZE=0x4000
CONFIG_ENV_SECT_SIZE=0x20000
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_SYS_FLASH_USE_BUFFER_WRITE is not set
