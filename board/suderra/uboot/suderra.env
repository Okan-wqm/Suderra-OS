# Suderra OS - production U-Boot default environment (ADR-048 DEC-18).
#
# This file is the whole default environment of the production U-Boot
# (CONFIG_USE_DEFAULT_ENV_FILE; Buildroot: BR2_TARGET_UBOOT_DEFAULT_ENV_FILE).
# Nothing of the board's own rpi.env or of the Kconfig defaults is added to it,
# so a variable that is not written here does not exist. With
# CONFIG_ENV_WRITEABLE_LIST the stored environment can change BOOT_ORDER,
# BOOT_A_LEFT and BOOT_B_LEFT and nothing else (board/suderra/uboot/patches),
# so this file is also the only source of bootcmd.
#
# Format: mkenvimage's - one name=value per line, a line starting with "#" is a
# comment, a trailing backslash continues the value on the next line.
#
# scripts/ci/check-uboot-config.py checks this file; tests/qemu/
# arm-fit-signature-boot.sh boots a build of the same logic on QEMU. The
# per-board values below (fitaddr, suderra_bootdev) are the Raspberry Pi
# family's; the QEMU test replaces exactly those and nothing else.

# Autoboot at once, no key check (-1 would STOP at the prompt). stdin is the
# null device: no key reaches U-Boot, whatever the serial line carries.
bootdelay=-2
stdin=nulldev
stdout=serial
stderr=serial

# The kernel, ramdisk and device tree stay where the FIT put them: U-Boot must
# not relocate them over the device tree the firmware passed in.
fdt_high=ffffffffffffffff
initrd_high=ffffffffffffffff

# Where the signed FIT of the chosen slot is loaded, and from which device:
# the FAT boot partition of the disk the firmware loaded U-Boot from.
fitaddr=0x02000000
suderra_bootdev=mmc 0:1

# A/B slot state. The RAUC U-Boot backend writes BOOT_ORDER and the counters
# (fw_setenv; package/suderra-rauc-config). A counter equal to
# suderra_good_attempts marks a slot RAUC confirmed good: it boots without a
# write. Any other positive value is the remaining tries of a freshly installed
# slot (system.conf boot-attempts-primary < boot-attempts): each boot spends one
# and saves, so a slot that never reaches mark-good falls back after the last.
# A boot of a confirmed slot writes nothing (24 V sites lose power without
# warning; every write is a chance to lose the environment and wears the flash).
# The factory image carries slot A only, so B starts exhausted.
suderra_good_attempts=3
BOOT_ORDER=A B
BOOT_A_LEFT=3
BOOT_B_LEFT=0

# The control FDT is the device tree U-Boot itself runs with (OF_BOARD: the one
# the firmware passed in, which U-Boot copies when it relocates), and the one
# FIT verification reads its key from; U-Boot sets fdtcontroladdr to it after
# the environment is loaded, so no stored variable can name another tree. U-Boot
# accepts ANY FIT when that tree has no /signature node (boot/image-fit-sig.c),
# so boot only when it carries the key and demands a signed configuration
# (required = "conf"). The image build inserts the /signature node into the board
# DTBs the firmware loads.
suderra_guard=\
setenv suderra_required; \
fdt addr ${fdtcontroladdr}; \
fdt get value suderra_required /signature/key-fit-signing required; \
test "${suderra_required}" = conf

# Slot choice (the first slot of BOOT_ORDER with tries left).
suderra_try_A=\
if test ${BOOT_A_LEFT} -gt 0; then \
  if test ${BOOT_A_LEFT} -ne ${suderra_good_attempts}; then \
    setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1; \
    setenv suderra_save 1; \
  fi; \
  setenv suderra_slot A; \
fi
suderra_try_B=\
if test ${BOOT_B_LEFT} -gt 0; then \
  if test ${BOOT_B_LEFT} -ne ${suderra_good_attempts}; then \
    setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1; \
    setenv suderra_save 1; \
  fi; \
  setenv suderra_slot B; \
fi
suderra_pick=\
setenv suderra_slot; \
setenv suderra_save; \
for suderra_s in ${BOOT_ORDER}; do \
  if test -z "${suderra_slot}"; then \
    if test "${suderra_s}" = A; then run suderra_try_A; fi; \
    if test "${suderra_s}" = B; then run suderra_try_B; fi; \
  fi; \
done; \
if test -n "${suderra_save}"; then saveenv; fi

# Load the signed FIT of the slot and boot it. bootm verifies the signature of
# the configuration against the control FDT's key and fails otherwise; the
# kernel command line is the /chosen/bootargs of the FIT's signed device tree
# (no bootargs variable exists to replace it).
suderra_boot=\
echo Suderra: booting slot ${suderra_slot}; \
load ${suderra_bootdev} ${fitaddr} suderra-${suderra_slot}.fit && bootm ${fitaddr}

# Nothing here ever returns to a prompt: a failed guard, an exhausted
# BOOT_ORDER, a FIT that fails to load or verify all end in a reset.
bootcmd=\
if run suderra_guard; then \
  run suderra_pick; \
  if test -n "${suderra_slot}"; then run suderra_boot; fi; \
  echo Suderra: slot ${suderra_slot} did not boot; \
else \
  echo Suderra: the control FDT carries no required FIT key; \
fi; \
reset
