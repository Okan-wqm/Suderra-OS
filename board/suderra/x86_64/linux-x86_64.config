#
# Suderra OS — x86_64 kernel config (Katman 3)
#
# Bu config QEMU virtio + gerçek endüstriyel x86 PC'lerin yaygın donanım
# desteğini içerir. BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE olarak kullanılır
# (suderra_x86_64_defconfig, suderra_qemu_x86_64_prod_ab_defconfig); üzerine
# board/suderra/common/kernel-fragment.config uygulanır ve yazılmayan her
# sembol Kconfig varsayılanını alır. Kernel monolitiktir (kernel-fragment:
# CONFIG_MODULES kapalı), bu yüzden her sürücü =y'dir.
#
# Satır sonu yorumu yoktur: her yorum kendi satırındadır, sembol satırı
# yalnız CONFIG_<NAME>=<value> içerir (kernel-config-contract-test.sh bu
# satırları ayrıştırır ve her sembolün kernel'de var olduğunu doğrular).
#
# Hedef boyut: ~6-8 MB compressed (vs Ubuntu generic ~50 MB)
#

# 64-bit
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8

# Compiler hardening (ileri kernel'lerde varsayılan)
CONFIG_CC_HAS_AUTO_VAR_INIT_PATTERN=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_GCC_PLUGIN_STACKLEAK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# 6.9'da MITIGATION_ önekiyle yeniden adlandırıldı (eski PAGE_TABLE_ISOLATION,
# RETPOLINE adları 6.12'de yoktur ve sessizce düşerdi).
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
# SMAP 5.19'dan beri koşulsuzdur (X86_SMAP sembolü yoktur).
CONFIG_X86_UMIP=y

# CPU features
CONFIG_GENERIC_CPU=y
CONFIG_X86_PAT=y
CONFIG_X86_MCE=y
# CPU mikro kodu yükleyicisi (x86'da def_bool y; açıkça sabitlenir). Model
# başına mikro kod blob'ları ve erken yükleme model qualification'ında
# kesinleşir (ADR-048 DEC-8.10).
CONFIG_MICROCODE=y

# Memory
CONFIG_SLUB=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# PCI bus: NVMe, AHCI, every NIC below, virtio-pci (QEMU) and the xHCI host
# controller sit on PCI/PCIe. drivers/pci/Kconfig gives PCI no default, so
# without this line the custom config resolves to a kernel that sees none of
# them (kernel-config-contract-test.sh catches such silent drops).
CONFIG_PCI=y

# Block / Storage
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
# NVMe (modern endüstriyel)
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
# SATA (legacy)
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

# Initramfs (ADR-048 DEC-8.10, EI-009): the signed UKI carries the dm-verity
# initramfs (scripts/production-artifacts.sh, gzip cpio) in its .initrd
# section; without BLK_DEV_INITRD the EFI stub ignores it and
# root=/dev/mapper/suderra-root never appears.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Device mapper: dm-verity rootfs and LUKS2 /data (ADR-048 DEC-8.10, EI-020;
# suderra-data-unlock runs cryptsetup luksFormat/open with the default
# aes-xts-plain64 cipher and AF_ALG keyslot encryption).
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# EFI partition
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Networking — TCP/IP only, IPv6 minimum
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
# systemd istiyor; IPv6 runtime'da sysctl ile kapanır
CONFIG_IPV6=y
CONFIG_INET_DIAG=y

# Firewall (ADR-048 DEC-8.10, DEC-11, EI-021): nftables.conf and
# nftables.provisioning.conf use inet tables, "ct state", "limit" and a
# per-source meter, so without conntrack/ct/limit `nft -f` rejects the whole
# ruleset. NFT_LOG needs a logger backend (NF_LOG_SYSLOG) or a "log" rule
# fails to load.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NF_LOG_SYSLOG=y

# Network drivers — virtio (QEMU) + Intel/Realtek (gerçek hw)
CONFIG_NETDEVICES=y
# QEMU
CONFIG_VIRTIO_NET=y
# Intel legacy (Pro/1000)
CONFIG_E1000=y
# Intel modern (I217/I219)
CONFIG_E1000E=y
# Intel I210/I211 (endüstriyel)
CONFIG_IGB=y
# Intel I225/I226 (TSN/PTP destekli)
CONFIG_IGC=y
# Realtek
CONFIG_R8169=y

# Virtio (QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y

# UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=y

# USB field I/O (ADR-048 DEC-8.10, EI-043): xHCI host, HID and the RS485/RS232
# adapters the qemu-x86_64 and x86 agent drop-ins grant (char-ttyUSB,
# char-ttyACM). USB mass storage (below, x86 industrial PC block) is built in
# for the PROVISIONING/MAINTENANCE-only ingress unit (DEC-18.2); in ACTIVE the
# usbguard policy keeps the storage class unauthorized.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# Watchdog (donanım dondu reboot)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
# Intel iTCO (yaygın endüstriyel)
CONFIG_ITCO_WDT=y
# fallback
CONFIG_SOFT_WATCHDOG=y

# TPM 2.0: tpm-ek-sha256 device binding (boards.json) and the LUKS2 seal
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# QEMU swtpm
CONFIG_TCG_VTPM_PROXY=y

# RTC (real-time clock)
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# ---------------------------------------------------------------------------
# Industrial x86 PC driver set (ADR-048 DEC-8.9, DEC-8.10, DEC-14, DEC-18.2).
# No model is chosen (Soru 1), so this is the model-independent base every
# candidate is qualified against; a model whose qualification record
# (docs/operations/x86-qualification-record.schema.json) needs a driver
# outside it adds that symbol to its own board fragment, and
# scripts/ci/check-kernel-config.py requires the record's symbols to be =y.
# The kernel is monolithic, so each driver is =y. Every symbol below is
# required by a capability of scripts/ci/check-kernel-config.py (x86-ipc-*).
# ---------------------------------------------------------------------------

# Identity (DEC-8.2): the agent's board cross-check reads the DMI vendor and
# product from /sys/class/dmi/id; DMIID exports them.
CONFIG_DMI=y
CONFIG_DMIID=y

# Firmware interface: efivarfs is how the installer reads SetupMode and
# SecureBoot, enrolls the Suderra PK/KEK/db and removes the Windows Boot####
# entries (DEC-8.9). EFI_VARS no longer exists; efivarfs is the only
# interface.
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y

# CPU microcode (DEC-8.10): the loader is built for both vendors; the early
# blobs travel in the signed UKI of a qualified model (qualification record
# microcode field), so no blob is built into the kernel image
# (EXTRA_FIRMWARE stays empty).
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_FW_LOADER=y

# DMA protection (DEC-8.9 step 6): the IOMMU is on from boot and translates
# strictly, so a malicious PCIe or Thunderbolt device cannot read memory
# before userspace configures anything.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# Storage: eMMC and SD on industrial SoMs (sdhci-pci and sdhci-acpi), USB mass
# storage for the installer medium and the provisioning bundle ingress
# (usb-storage and UAS; DEC-18.2). NVMe, AHCI SATA and SCSI disk are above.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Technician media are FAT: mounting one with the default iocharset needs the
# code page and charset tables built in.
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Network: PTP hardware clocks of I210/I225/I226 (linuxptp). The NIC drivers
# e1000e, igb, igc and r8169 are in the network block above.
CONFIG_PTP_1588_CLOCK=y

# Serial ports: the onboard COM ports are ACPI/PNP devices; Exar and Pericom
# PCIe multi-port cards and the Intel LPSS and DesignWare UARTs are the
# RS485/RS232 interfaces of industrial PCs (RS485 mode is the serial core's
# TIOCSRS485, driven by the 8250 port drivers).
CONFIG_SERIAL_8250_PNP=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_8250_NR_UARTS=16
CONFIG_SERIAL_8250_RUNTIME_UARTS=16
CONFIG_SERIAL_8250_EXAR=y
CONFIG_SERIAL_8250_PERICOM=y
CONFIG_SERIAL_8250_LPSS=y
CONFIG_SERIAL_8250_DW=y

# Hardware watchdogs (DEC-6, DEC-8 matrix): iTCO (above) plus the vendor
# timers and the Super I/O watchdogs of industrial boards (ITE, Fintek,
# Nuvoton NCT6775 and later through the W83627HF driver) and the ACPI WDAT
# table. Which one a model has is a qualification fact.
CONFIG_ITCO_VENDOR_SUPPORT=y
CONFIG_SP5100_TCO=y
CONFIG_IT87_WDT=y
CONFIG_F71808E_WDT=y
CONFIG_W83627HF_WDT=y
CONFIG_WDAT_WDT=y

# SMBus and GPIO: the chipset SMBus (iTCO and the DIMM/board sensors sit
# behind it), the LPC bridge MFD, and the digital I/O of the Super I/O chips.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SMBUS=y
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_LPC_ICH=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_ICH=y
CONFIG_GPIO_F7188X=y
CONFIG_GPIO_IT87=y

# CAN (the x86 agent drop-in grants AF_CAN): the protocol stack with raw and
# broadcast-manager sockets, the device framework, the PCI controllers of
# industrial CAN cards and boards (SJA1000 family: Kvaser, PEAK, EMS, PLX,
# Fintek; C_CAN, Bosch M_CAN on Intel Elkhart Lake, CTU CAN FD) and the USB
# adapters (PEAK, gs_usb).
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_DEV=y
CONFIG_CAN_SJA1000=y
CONFIG_CAN_KVASER_PCI=y
CONFIG_CAN_PEAK_PCI=y
CONFIG_CAN_EMS_PCI=y
CONFIG_CAN_PLX_PCI=y
CONFIG_CAN_F81601=y
CONFIG_CAN_C_CAN=y
CONFIG_CAN_C_CAN_PCI=y
CONFIG_CAN_M_CAN=y
CONFIG_CAN_M_CAN_PCI=y
CONFIG_CAN_CTUCANFD=y
CONFIG_CAN_CTUCANFD_PCI=y
CONFIG_CAN_PEAK_USB=y
CONFIG_CAN_GS_USB=y

# Console
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Cryptography (rustls + LUKS2 için)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
# AES-NI hardware acceleration
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_GCM=y
# LUKS2 (aes-xts-plain64)
CONFIG_CRYPTO_XTS=y
# cryptsetup keyslot encryption through AF_ALG (EI-020)
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Power management
CONFIG_PM=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_HWMON=y
# CPU sıcaklık (telemetry için)
CONFIG_SENSORS_CORETEMP=y

# Random
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_TPM=y
# QEMU virtio-rng
CONFIG_HW_RANDOM_VIRTIO=y

# Cgroup v2 (systemd zorunlu)
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# Agent unit sandbox (contracts/suderra-edge/v1/unit-directives.json):
# DevicePolicy=closed and DeviceAllow= are enforced on the unified cgroup
# hierarchy only by a cgroup BPF device program; without CGROUP_BPF systemd
# starts the agent with no device filter. BPF_SYSCALL and BPF_JIT also make
# kernel-fragment.config's BPF_UNPRIV_DEFAULT_OFF and BPF_JIT_ALWAYS_ON
# take effect.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y

# Namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
# No IPC namespace: SYSVIPC and POSIX_MQUEUE are not built (IPC_NS depends on
# one of them), so there is no IPC object to namespace.
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# Faz 3'te kapatılabilir (saldırı yüzeyi)
CONFIG_USER_NS=y

# seccomp + audit (Faz 3 + sertleştirme)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# memfd_secret (Edge Agent zorunlu)
CONFIG_MEMFD_CREATE=y
CONFIG_SECRETMEM=y

# systemd zorunlu özellikler
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y

# Disable unused (saldırı yüzeyi azalt)
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_NFC is not set
# CONFIG_RDS is not set
# CONFIG_IP_DCCP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
# CONFIG_X25 is not set
# CONFIG_LLC2 is not set
# CONFIG_USERFAULTFD is not set

# Module loading: none. kernel-fragment.config, applied after this file on
# every defconfig that uses it, turns CONFIG_MODULES off (monolithic kernel).
