#
# Suderra OS QEMU x86_64 kernel fragment
#
# These options must be built in because the QEMU image has no initramfs.

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# ADR-048 DEC-8.10: the dev QEMU image runs the same edge provisioning chain
# as the boards, so its kernel declares every symbol that chain needs as
# built-in instead of inheriting it from x86_64_defconfig or leaving it as a
# module (tests/image-contracts/kernel-config-contract-test.sh).

# Firewall (DEC-11): nftables.conf and nftables.provisioning.conf use inet
# tables, "ct state", "limit" and a per-source meter; NFT_LOG needs a logger
# backend (NF_LOG_SYSLOG) or a "log" rule fails to load.
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NF_LOG_SYSLOG=y

# swtpm: the tpm-ek-sha256 device binding of qemu-x86_64 (boards.json).
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y

# dm-crypt for LUKS2 (cryptsetup's default aes-xts-plain64 and its AF_ALG
# keyslot encryption).
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Agent unit sandbox (unit-directives.json): DevicePolicy=closed and
# DeviceAllow= are enforced on the unified cgroup hierarchy only by a cgroup
# BPF device program; without CGROUP_BPF systemd starts the agent with no
# device filter at all.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Field I/O of the qemu-x86_64 agent drop-in (char-ttyS, char-ttyUSB,
# char-ttyACM): 8250 UARTs, the xHCI host and the USB RS485/RS232 adapters;
# QEMU's usb-serial device is an FTDI FT232.
CONFIG_SERIAL_8250=y
CONFIG_PCI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# The CMOS clock (DEC-7.8): every x86 board's RTC, and QEMU's. The kernel reads
# it at boot and, while chrony's rtcsync (etc/chrony.conf) says the clock is
# synchronized, writes the system time back every 11 minutes. Enforced as the
# x86-rtc capability of scripts/ci/check-kernel-config.py.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
