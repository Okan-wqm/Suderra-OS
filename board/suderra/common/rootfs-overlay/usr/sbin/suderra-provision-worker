#!/bin/sh
# Root provisioning worker (ADR-048 DEC-5.5, DEC-5.6, DEC-5.9).
#
# Claims the forced command's request and token from the provision-owned
# inbox, then hands everything that matters to the Rust root installer:
# `suderra-installer edge provision` sends the token only in the
# X-Provisioning-Token header, fetches this device's signed delivery, verifies
# every statement against the image's pinned keys and the device binding,
# downloads and verifies the artifact and installs it atomically. The worker
# writes the result for the technician ("installed, waiting for activation")
# and starts the agent; lockdown happens later, once root has verified the
# activation receipt (suderra-activation.service).
#
# Claiming is a rename into the root-only RuntimeDirectory: rename never
# follows a symlink, and the file is checked after it moved, so the provision
# user cannot swap it between the check and the use.
set -eu

SPOOL=/var/spool/suderra-provision
INBOX="${SPOOL}/inbox"
RESULT="${SPOOL}/result"
WORK=/run/suderra-installer
INSTALLER=/usr/bin/suderra-installer

umask 077

# Writes the result the provision user reads back (root:provision 0640).
write_result() {
    {
        printf 'request=%s\n' "${request_id}"
        printf 'status=%s\n' "$1"
        printf '%s\n' "$2"
    } > "${SPOOL}/.result.tmp"
    chgrp provision "${SPOOL}/.result.tmp"
    chmod 0640 "${SPOOL}/.result.tmp"
    mv -f "${SPOOL}/.result.tmp" "${RESULT}"
}

claim() {
    name="$1"
    limit="$2"
    mv -f "${INBOX}/${name}" "${WORK}/${name}" 2>/dev/null || return 1
    if [ -L "${WORK}/${name}" ] || [ ! -f "${WORK}/${name}" ] || [ ! -s "${WORK}/${name}" ]; then
        return 1
    fi
    [ "$(wc -c < "${WORK}/${name}")" -le "${limit}" ]
}

# The path unit watches only the trigger; removing it first means a failed
# run does not re-trigger in a loop.
rm -f "${INBOX}/trigger"
rm -f "${RESULT}" "${INBOX}/result-read"

request_id=unknown
claim request 512 || exit 1
request_id="$(sed -n 's/^id=\([0-9a-f]\{32\}\)$/\1/p' "${WORK}/request")"
device_code="$(sed -n 's/^device_code=\([A-Za-z0-9_-]\{1,50\}\)$/\1/p' "${WORK}/request")"
[ -n "${request_id}" ] || exit 1
if [ -z "${device_code}" ]; then
    write_result error "message=malformed provisioning request"
    exit 1
fi
if ! claim token 4097; then
    write_result error "message=no provisioning token"
    exit 1
fi

if out="$("${INSTALLER}" edge provision --device-code "${device_code}" \
        --token-file "${WORK}/token" 2>"${WORK}/stderr")"; then
    rm -f "${WORK}/token"
    version="$(printf '%s\n' "${out}" | sed -n 's/^installed \([^ ]*\) .*/\1/p')"
    write_result installed "version=${version}
message=installed, waiting for activation"
    /usr/sbin/suderra-identity mirror
    systemctl --no-block restart suderra-agent.service
    exit 0
fi
rm -f "${WORK}/token"
# The installer's last diagnostic line, printable ASCII only, at most 512 bytes.
reason="$(tail -n 1 "${WORK}/stderr" | tr -cd ' -~' | cut -c1-512)"
write_result error "message=${reason:-edge provisioning failed}"
exit 1
