#!/bin/sh
# Reports whether the device is locked down (ADR-048 DEC-5.9, DEC-11, DEC-12).
# Exit 0 when every check passes. Read-only: it changes nothing.
set -eu

INSTALLER=/usr/bin/suderra-installer
status=0

ok() {
    echo "OK: $1"
}

fail() {
    echo "FAIL: $1"
    status=1
}

is_mounted() {
    awk -v target="$1" '$5 == target { found = 1 } END { exit !found }' /proc/self/mountinfo
}

account_locked() {
    awk -F: -v user="$1" '$1 == user { found = 1; locked = ($2 ~ /^[!*]/) } END { exit !(found && locked) }' /etc/shadow
}

state="$("${INSTALLER}" lifecycle status 2>/dev/null || echo unknown)"
if [ "${state}" = ACTIVE ]; then
    ok "lifecycle is ACTIVE (root-verified activation receipt)"
else
    fail "lifecycle is ${state}, not ACTIVE"
fi

if is_mounted /etc/shadow; then
    fail "a provisioning one-time-password shadow is bound over /etc/shadow"
else
    ok "no one-time-password shadow is bound"
fi
for user in root provision; do
    if account_locked "${user}"; then
        ok "${user} password login locked"
    else
        fail "${user} password login is not locked"
    fi
done

for unit in suderra-provision-mode.service dropbear.service suderra-provision-worker.path; do
    if systemctl is-active --quiet "${unit}"; then
        fail "${unit} is active"
    else
        ok "${unit} is not active"
    fi
done
if is_mounted /var/spool/suderra-provision; then
    fail "the provisioning spool is still bound"
else
    ok "the provisioning spool is gone"
fi

recorded="/data/suderra/os/firewall/loaded.sha256"
if [ -f "${recorded}" ] &&
   [ "$(nft list ruleset | sha256sum | cut -d' ' -f1)" = "$(cat "${recorded}")" ]; then
    ok "loaded ruleset matches the recorded hash"
else
    fail "loaded ruleset does not match the recorded hash"
fi
if nft list ruleset | grep -q 'dport 22'; then
    fail "an SSH rule is loaded"
else
    ok "no SSH rule is loaded"
fi

if [ -x /opt/suderra/edge/current/suderra-agent ]; then
    ok "suderra-agent release installed"
else
    fail "suderra-agent release missing"
fi
if systemctl is-active --quiet suderra-agent.service; then
    ok "suderra-agent.service active"
else
    fail "suderra-agent.service not active"
fi

exit "${status}"
