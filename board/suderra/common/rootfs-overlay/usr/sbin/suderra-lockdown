#!/bin/sh
# Lockdown after registration (ADR-048 DEC-5.8, DEC-5.9, DEC-11.3, DEC-12).
#
# Runs from suderra-activation.service right after root verified the
# activation receipt and recorded ACTIVE; it is keyed on that verified state,
# never on a marker the agent could write or delete. It
#   1. lets the technician read the install result (until the forced command
#      acknowledges it, plus a short grace; bounded),
#   2. stops suderra-provision-mode.service: dropbear, the worker and every
#      provision session stop with it, the image's locked shadow returns over
#      the one-time password and the spool is destroyed,
#   3. loads the appliance ruleset and refuses to report success otherwise,
#   4. writes a lockdown result (DEC-27).
# Nothing under /etc is written: no shadow edit, no unit masks.
set -eu

INSTALLER=/usr/bin/suderra-installer
SPOOL=/var/spool/suderra-provision
RESULT="${SPOOL}/result"
ACK="${SPOOL}/inbox/result-read"
GRACE_AFTER_READ=10
MAX_WAIT=900

failed() {
    reason="$1"
    shift
    echo "ERROR: $*" >&2
    "${INSTALLER}" result write --kind lockdown --outcome failed --reason "${reason}" \
        --detail "$*" >/dev/null
    exit 1
}

is_mounted() {
    awk -v target="$1" '$5 == target { found = 1 } END { exit !found }' /proc/self/mountinfo
}

state="$("${INSTALLER}" lifecycle status)"
[ "${state}" = ACTIVE ] ||
    failed lifecycle-inconsistent "lockdown follows a verified activation receipt, but the lifecycle is ${state}"

if [ -f "${RESULT}" ]; then
    waited=0
    while [ ! -f "${ACK}" ] && [ "${waited}" -lt "${MAX_WAIT}" ]; do
        sleep 2
        waited=$((waited + 2))
    done
    if [ -f "${ACK}" ]; then
        sleep "${GRACE_AFTER_READ}"
    fi
fi

systemctl stop suderra-provision-mode.service ||
    failed io-error "cannot stop suderra-provision-mode.service"
if systemctl is-active --quiet dropbear.service; then
    failed state-corrupt "dropbear is still running after provisioning mode stopped"
fi
if is_mounted /etc/shadow; then
    failed state-corrupt "the one-time-password shadow is still bound over /etc/shadow"
fi

loaded="$("${INSTALLER}" policy apply)" ||
    failed firewall-load-failed "suderra-installer policy apply failed"
[ "${loaded}" = appliance ] ||
    failed firewall-load-failed "policy apply loaded '${loaded}' instead of the appliance ruleset"

"${INSTALLER}" result write --kind lockdown --outcome ok >/dev/null
echo "==> Appliance lockdown complete"
