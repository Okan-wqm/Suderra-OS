# Renews the provisioning one-time password after every failed password
# attempt on the provision account (ADR-048 DEC-5.2). Runs only inside the
# open provisioning window.

[Unit]
Description=Renew the provisioning one-time password after a failed login
Documentation=https://github.com/Okan-wqm/suderra-os
ConditionPathExists=/run/suderra-os/provisioning-open
BindsTo=suderra-provision-mode.service
After=suderra-provision-mode.service

[Service]
Type=simple
ExecStart=/usr/sbin/suderra-provision-mode guard
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
