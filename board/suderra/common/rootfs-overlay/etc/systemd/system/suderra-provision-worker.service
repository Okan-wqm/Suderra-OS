# Root provisioning worker (ADR-048 DEC-5.5, DEC-5.6, DEC-24): claims the
# forced command's request and token and runs
# `suderra-installer edge provision`, which fetches this device's signed
# delivery with the token in the X-Provisioning-Token header, verifies every
# statement and installs the agent; the result goes back to the technician.
#
# Every path the installer writes is listed in ReadWritePaths= (EI-001);
# everything else is read-only. The claimed token and request live in
# RuntimeDirectory=, which systemd removes when the run ends.

[Unit]
Description=Suderra OS provisioning worker
Documentation=https://github.com/Okan-wqm/suderra-os
ConditionPathExists=/etc/suderra/board
ConditionPathExists=/run/suderra-os/provisioning-open
BindsTo=suderra-provision-mode.service
After=suderra-provision-mode.service suderra-data.service nftables.service time-sync.target
# The signed statements it verifies have validity windows, so it runs after
# time-sync.target (DEC-5.13, DEC-7.4): Wants=, never Requires=, because the
# target is reached after a bounded wait whether the clock synchronized or not
# and an unsynchronized clock is a result the technician reads (clock-unsynced),
# not a reason for the worker not to run.
Wants=time-sync.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/suderra-provision-worker
User=root
Group=root
UMask=0077
RuntimeDirectory=suderra-installer
RuntimeDirectoryMode=0700
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/data/suderra/os -/data/suderra/edge -/data/suderra/site
ReadWritePaths=/run/suderra /run/suderra-os /run/suderra-update.lock /var/spool/suderra-provision
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
