{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:result",
  "title": "suderra.result.v1 install and update result",
  "description": "Typed result that root workers write to /data/suderra/os/results/ and expose under /run/suderra/results/ (directory root:suderra 0750, files 0640); the agent publishes it on its result topic and the cloud stores it per device (ADR-048 DEC-27). Unsigned: an observation, never authority. reason is enumerated per kind: the rejection codes of the statements that kind verifies (statements.json unsigned_documents reasons_by_kind) plus its operational codes. A result of a kind that a request on the update channel causes (edge-update, os-update, site-config, site-netpolicy, trust-anchors) names the statement it concludes in subject.statement_type and subject.statement_digest: that digest is what settles the request (channels.json update_channel.settlement).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "seq",
    "kind",
    "outcome",
    "occurred_at",
    "time_state",
    "board_profile",
    "os_version"
  ],
  "properties": {
    "_type": {
      "const": "suderra.result.v1"
    },
    "seq": {
      "description": "Monotonic per device, assigned by root.",
      "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/sequence"
    },
    "kind": {
      "enum": [
        "provisioning",
        "edge-install",
        "edge-update",
        "edge-rollback",
        "verify-current",
        "site-config",
        "lockdown",
        "lifecycle",
        "health-gate",
        "data-unlock",
        "time-state",
        "os-update",
        "update-request",
        "site-netpolicy",
        "trust-anchors"
      ]
    },
    "outcome": {
      "enum": ["ok", "rejected", "failed", "alarm"]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "occurred_at": {
      "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/timestamp"
    },
    "time_state": {
      "description": "Clock trust when occurred_at was taken (DEC-7.3).",
      "enum": ["unsynced", "synced-unauthenticated", "synced-nts"]
    },
    "board_profile": {
      "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/board_profile"
    },
    "os_version": {
      "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/os_version"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "version": {
          "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/semver"
        },
        "security_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "statement_type": {
          "type": "string",
          "pattern": "^suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*$"
        },
        "statement_digest": {
          "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/digest"
        },
        "update_seq": {
          "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/sequence"
        },
        "lifecycle_from": {
          "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/lifecycle_state"
        },
        "lifecycle_to": {
          "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/lifecycle_state"
        }
      }
    },
    "detail": {
      "type": "string",
      "maxLength": 512
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "ok"
        },
        "reason": false
      }
    },
    {
      "properties": {
        "outcome": {
          "enum": ["rejected", "failed", "alarm"]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["reason"]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "provisioning"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "actor-key-not-anchored",
              "agent-abi-unsupported",
              "anchor-invalid",
              "anchor-not-os-pinned",
              "archive-invalid",
              "artifact-digest-mismatch",
              "binary-digest-mismatch",
              "board-mismatch",
              "clock-unsynced",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "fetch-failed",
              "io-error",
              "kernel-config-missing",
              "key-epoch-below-ratchet",
              "key-epoch-mismatch",
              "key-purpose-mismatch",
              "key-unknown",
              "nonce-mismatch",
              "not-yet-valid",
              "os-version-too-old",
              "payload-json-invalid",
              "payload-type-mismatch",
              "rbac-manifest-digest-mismatch",
              "release-digest-mismatch",
              "release-mismatch",
              "release-profile-mismatch",
              "rollback-below-floor",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "site-config-digest-mismatch",
              "site-file-digest-mismatch",
              "tenant-mismatch",
              "tenant-scope-mismatch",
              "trust-anchors-digest-mismatch",
              "usb-layout-invalid"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "edge-install"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "agent-abi-unsupported",
              "archive-invalid",
              "artifact-digest-mismatch",
              "binary-digest-mismatch",
              "board-mismatch",
              "clock-unsynced",
              "envelope-invalid",
              "fetch-failed",
              "io-error",
              "kernel-config-missing",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "os-version-too-old",
              "payload-json-invalid",
              "payload-type-mismatch",
              "release-profile-mismatch",
              "schema-invalid",
              "signature-invalid"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "edge-update"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "agent-abi-unsupported",
              "approval-missing",
              "archive-invalid",
              "artifact-digest-mismatch",
              "binary-digest-mismatch",
              "board-mismatch",
              "clock-unsynced",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "fetch-failed",
              "io-error",
              "kernel-config-missing",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "maintenance-blocked",
              "not-yet-valid",
              "os-version-too-old",
              "payload-json-invalid",
              "payload-type-mismatch",
              "release-digest-mismatch",
              "release-mismatch",
              "release-profile-mismatch",
              "rollback-below-floor",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "tenant-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "edge-rollback"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": ["health-window-failed", "io-error"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verify-current"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "actor-key-not-anchored",
              "agent-abi-unsupported",
              "anchor-invalid",
              "anchor-not-os-pinned",
              "binary-digest-mismatch",
              "board-mismatch",
              "current-link-mismatch",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "installed-digest-mismatch",
              "kernel-config-missing",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "os-version-too-old",
              "payload-json-invalid",
              "payload-type-mismatch",
              "rbac-manifest-digest-mismatch",
              "release-not-installed",
              "release-profile-mismatch",
              "schema-invalid",
              "signature-invalid",
              "site-file-digest-mismatch",
              "tenant-mismatch",
              "tenant-scope-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "site-config"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "actor-key-not-anchored",
              "anchor-invalid",
              "anchor-not-os-pinned",
              "approval-missing",
              "clock-unsynced",
              "config-rsc-load-failed",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "fetch-failed",
              "io-error",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "maintenance-blocked",
              "not-yet-valid",
              "payload-json-invalid",
              "payload-type-mismatch",
              "rbac-manifest-digest-mismatch",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "site-bundle-missing",
              "site-file-digest-mismatch",
              "tenant-mismatch",
              "tenant-scope-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lockdown"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "firewall-load-failed",
              "io-error",
              "lifecycle-inconsistent",
              "provisioning-mode-active",
              "receipt-missing"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lifecycle"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "io-error",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "manifest-digest-mismatch",
              "not-yet-valid",
              "payload-json-invalid",
              "payload-type-mismatch",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "state-corrupt",
              "tenant-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "health-gate"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "abi-incompatible",
              "agent-degraded",
              "agent-not-active",
              "bsp-probe-failed",
              "clock-below-floor",
              "data-mapper-missing",
              "firewall-hash-mismatch",
              "lifecycle-inconsistent",
              "tpm-unavailable",
              "verity-inactive"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "data-unlock"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": ["data-unmountable", "io-error", "tpm-unseal-failed"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "time-state"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": ["clock-below-floor", "clock-unsynced"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "os-update"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "agent-abi-unsupported",
              "approval-missing",
              "artifact-digest-mismatch",
              "clock-unsynced",
              "compatible-mismatch",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "fetch-failed",
              "io-error",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "maintenance-blocked",
              "not-yet-valid",
              "os-version-too-old",
              "payload-json-invalid",
              "payload-type-mismatch",
              "rauc-install-failed",
              "rollback-below-floor",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "tenant-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update-request"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "io-error",
              "request-not-regular-file",
              "request-too-large",
              "request-unsupported"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "site-netpolicy"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "clock-unsynced",
              "device-binding-mismatch",
              "device-id-mismatch",
              "envelope-invalid",
              "expired",
              "firewall-load-failed",
              "interface-mapping-invalid",
              "io-error",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "not-yet-valid",
              "payload-json-invalid",
              "payload-type-mismatch",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "tenant-mismatch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "trust-anchors"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "anchor-invalid",
              "anchor-not-os-pinned",
              "envelope-invalid",
              "io-error",
              "key-epoch-below-ratchet",
              "key-purpose-mismatch",
              "key-unknown",
              "payload-json-invalid",
              "payload-type-mismatch",
              "schema-invalid",
              "sequence-replay",
              "signature-invalid",
              "tenant-scope-mismatch"
            ]
          }
        }
      }
    }
  ],
  "if": {
    "properties": {
      "kind": {
        "enum": ["edge-update", "os-update", "site-config", "site-netpolicy", "trust-anchors"]
      }
    },
    "required": ["kind"]
  },
  "then": {
    "required": ["subject"],
    "properties": {
      "subject": {
        "properties": {
          "statement_type": true,
          "statement_digest": true
        },
        "required": ["statement_type", "statement_digest"]
      }
    }
  }
}
