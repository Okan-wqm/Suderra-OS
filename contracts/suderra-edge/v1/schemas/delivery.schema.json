{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:delivery",
  "title": "delivery.json provisioning delivery binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "request_type", "delivery_type", "network", "usb", "installation"],
  "properties": {
    "description": { "type": "string" },
    "request_type": { "const": "suderra.edge-provisioning-request.v1" },
    "delivery_type": { "const": "suderra.edge-provisioning-delivery.v1" },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "request", "response", "refusal"],
      "properties": {
        "phase": { "const": "P0" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "headers", "query_schema"],
          "properties": {
            "method": { "const": "GET" },
            "path": { "const": "/install/{device_code}/suderra-os" },
            "headers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["X-Provisioning-Token"],
              "properties": { "X-Provisioning-Token": { "type": "string" } }
            },
            "query_schema": { "const": "schemas/edge-provisioning-request.schema.json" }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "content_type", "schema"],
          "properties": {
            "status": { "const": 200 },
            "content_type": {
              "const": "application/vnd.suderra.edge-provisioning-delivery.v1+json"
            },
            "schema": { "const": "schemas/edge-provisioning-delivery.schema.json" }
          }
        },
        "refusal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "body", "rate_limited_status", "rule"],
          "properties": {
            "status": { "const": 404 },
            "body": { "const": "{\"error\":\"unavailable\"}" },
            "rate_limited_status": { "const": 429 },
            "rule": { "type": "string" }
          }
        }
      }
    },
    "usb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "directory", "files", "nonce", "ingress", "update_bundle"],
      "properties": {
        "phase": { "const": "P1" },
        "directory": { "const": "suderra-provisioning/{device_code}/" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery.json", "{artifact}"],
          "properties": {
            "delivery.json": { "type": "string" },
            "{artifact}": { "type": "string" }
          }
        },
        "nonce": { "type": "string" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "states",
            "states_rule",
            "mount",
            "layout",
            "limits",
            "procedure",
            "result"
          ],
          "properties": {
            "rule": { "type": "string" },
            "states": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": { "enum": ["PROVISIONING", "MAINTENANCE"] }
            },
            "states_rule": { "type": "string" },
            "mount": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "options"],
              "properties": {
                "namespace": { "type": "string" },
                "options": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 4,
                  "items": { "enum": ["ro", "nosuid", "nodev", "noexec"] }
                }
              }
            },
            "layout": {
              "type": "object",
              "additionalProperties": false,
              "required": ["top_directory", "rule", "artifact_name_pattern"],
              "properties": {
                "top_directory": { "const": "suderra-provisioning" },
                "rule": { "type": "string" },
                "artifact_name_pattern": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_directories",
                "max_files_per_directory",
                "max_delivery_bytes",
                "max_artifact_bytes"
              ],
              "properties": {
                "max_directories": { "type": "integer", "minimum": 1, "maximum": 256 },
                "max_files_per_directory": { "type": "integer", "minimum": 2, "maximum": 16 },
                "max_delivery_bytes": { "type": "integer", "minimum": 1048576, "maximum": 67108864 },
                "max_artifact_bytes": { "type": "integer", "minimum": 1048576, "maximum": 2147483648 }
              }
            },
            "procedure": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "result": { "type": "string" }
          }
        },
        "update_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "directory", "files", "rule"],
          "properties": {
            "phase": { "const": "P3" },
            "directory": { "const": "suderra-updates/{device_code}/{statement_digest}/" },
            "files": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement.dsse",
                "release.dsse.json",
                "artifact",
                "bundle.raucb",
                "site-bundle.json"
              ],
              "properties": {
                "statement.dsse": { "type": "string" },
                "release.dsse.json": { "type": "string" },
                "artifact": { "type": "string" },
                "bundle.raucb": { "type": "string" },
                "site-bundle.json": { "type": "string" }
              }
            },
            "rule": { "type": "string" }
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "release_statement",
        "trust_anchors",
        "site_config",
        "rbac_manifest",
        "site_files",
        "switch"
      ],
      "properties": {
        "manifest": { "type": "string" },
        "release_statement": { "type": "string" },
        "trust_anchors": { "type": "string" },
        "site_config": { "type": "string" },
        "rbac_manifest": { "type": "string" },
        "site_files": { "type": "string" },
        "switch": { "type": "string" }
      }
    }
  }
}
