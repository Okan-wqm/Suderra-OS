{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:boards",
  "title": "boards.json board vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "boards", "excluded_os_images", "unmapped_device_models"],
  "properties": {
    "description": {
      "type": "string"
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "board_profile",
          "role",
          "arch",
          "rust_target",
          "agent_profile",
          "cargo_features",
          "rauc_compatible",
          "device_binding_method",
          "identity_cross_check",
          "cloud_device_models",
          "os_images"
        ],
        "properties": {
          "board_profile": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/board_profile"
          },
          "role": {
            "enum": ["production-primary", "production-secondary", "production-tertiary", "ci"]
          },
          "arch": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/arch"
          },
          "rust_target": {
            "enum": ["aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"]
          },
          "agent_profile": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/agent_profile"
          },
          "cargo_features": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "rauc_compatible": {
            "type": "string",
            "pattern": "^suderra-os-[a-z0-9_-]+$"
          },
          "device_binding_method": {
            "enum": ["tpm-ek-sha256", "bcm2711-serial-otp-sha256", "dmi-product-uuid-sha256"]
          },
          "identity_cross_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "values"],
            "properties": {
              "source": {
                "enum": ["device-tree-compatible", "dmi-allowlist"]
              },
              "values": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "cloud_device_models": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "os_images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/os_image"
            }
          }
        }
      }
    },
    "excluded_os_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defconfig", "build_target", "reason"],
        "properties": {
          "defconfig": {
            "$ref": "#/$defs/defconfig"
          },
          "build_target": {
            "$ref": "#/$defs/build_target"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "unmapped_device_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_model", "reason"],
        "properties": {
          "device_model": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "$defs": {
    "defconfig": {
      "type": "string",
      "pattern": "^suderra_[a-z0-9_]+_defconfig$"
    },
    "build_target": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "os_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defconfig", "build_target"],
      "properties": {
        "defconfig": {
          "$ref": "#/$defs/defconfig"
        },
        "build_target": {
          "$ref": "#/$defs/build_target"
        }
      }
    }
  }
}
