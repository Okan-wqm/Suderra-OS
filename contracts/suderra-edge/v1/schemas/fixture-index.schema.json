{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:fixture-index",
  "title": "fixtures/index.json golden fixture index",
  "description": "Every golden fixture with the verdict each conforming verifier must reach. Paths are relative to fixtures/. statement_type is the call site the envelope is presented at. A rejected statement carries exactly one defect, so its reason is the only check that fails even when every check is evaluated. Every fixture is TEST-ONLY.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_only",
    "description",
    "evaluation_time",
    "device_contexts",
    "statements",
    "deliveries",
    "documents",
    "units",
    "pae_vectors",
    "signature_vectors"
  ],
  "properties": {
    "test_only": {
      "const": true
    },
    "description": {
      "type": "string"
    },
    "evaluation_time": {
      "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/timestamp"
    },
    "device_contexts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "board_profile",
          "arch",
          "device_binding",
          "tenant_id",
          "device_id",
          "security_version_floor",
          "accepted",
          "ratchet",
          "installed_manifest",
          "os_release",
          "kernel_config"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "board_profile": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/board_profile"
          },
          "arch": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/arch"
          },
          "device_binding": {
            "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/device_binding"
          },
          "tenant_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/uuid"
              }
            ]
          },
          "device_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/uuid"
              }
            ]
          },
          "security_version_floor": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "description": "Per statement type, the last accepted sequence value and that statement's digest (statements.json sequences and reverification).",
            "type": "object",
            "propertyNames": {
              "pattern": "^suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement_digest"],
              "properties": {
                "seq": {
                  "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/sequence"
                },
                "statement_digest": {
                  "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/digest"
                }
              }
            }
          },
          "ratchet": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/epoch"
            }
          },
          "installed_manifest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/path"
              }
            ]
          },
          "os_release": {
            "type": "object",
            "additionalProperties": false,
            "required": ["VERSION_ID", "SUDERRA_AGENT_ABI"],
            "properties": {
              "VERSION_ID": {
                "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/os_version"
              },
              "SUDERRA_AGENT_ABI": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)-(0|[1-9][0-9]*)$"
              }
            }
          },
          "kernel_config": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CONFIG_[A-Z0-9_]+=[ym]$"
            }
          }
        }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "statement_type",
          "expect",
          "device_context",
          "verifier",
          "mode",
          "inputs",
          "description"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "statement_type": {
            "type": "string",
            "pattern": "^suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*$"
          },
          "expect": {
            "enum": ["accept", "reject"]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "device_context": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            ]
          },
          "verifier": {
            "enum": ["os-root", "agent"]
          },
          "mode": {
            "enum": ["accept", "reverify"]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "release_statement": {
                "$ref": "#/$defs/path"
              },
              "trust_anchors": {
                "$ref": "#/$defs/path"
              },
              "site_config": {
                "$ref": "#/$defs/path"
              },
              "rbac_manifest": {
                "$ref": "#/$defs/path"
              },
              "site_files": {
                "type": "object",
                "propertyNames": {
                  "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/site_path"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/path"
                }
              },
              "request_nonce": {
                "type": "string",
                "pattern": "^[0-9a-f]{32,128}$"
              }
            }
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        },
        "oneOf": [
          {
            "properties": {
              "expect": {
                "const": "accept"
              },
              "reason": false
            }
          },
          {
            "properties": {
              "expect": {
                "const": "reject"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["reason"]
          }
        ]
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "device_context", "request", "expect", "description"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "device_context": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "request": {
            "$ref": "#/$defs/path"
          },
          "expect": {
            "enum": ["accept", "reject"]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        },
        "oneOf": [
          {
            "properties": {
              "expect": {
                "const": "accept"
              },
              "reason": false
            }
          },
          {
            "properties": {
              "expect": {
                "const": "reject"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["reason"]
          }
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "document_type", "expect", "description"],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "document_type": {
            "enum": ["suderra.result.v1", "suderra.edge-provisioning-request.v1"]
          },
          "expect": {
            "enum": ["accept", "reject"]
          },
          "reason": {
            "enum": ["payload-json-invalid", "schema-invalid"]
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        },
        "oneOf": [
          {
            "properties": {
              "expect": {
                "const": "accept"
              },
              "reason": false
            }
          },
          {
            "properties": {
              "expect": {
                "const": "reject"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["reason"]
          }
        ]
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "board_profile", "unit", "dropin", "expect", "description"],
        "properties": {
          "profile": {
            "enum": ["suderra-os", "generic"]
          },
          "board_profile": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "urn:suderra:edge-contract:v1:schema:common#/$defs/board_profile"
              }
            ]
          },
          "unit": {
            "$ref": "#/$defs/path"
          },
          "dropin": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/path"
              }
            ]
          },
          "expect": {
            "enum": ["accept", "reject"]
          },
          "violations": {
            "description": "Every rule hit the one defect produces, as <category>:<Section>.<Key> with category exact, required, present, forbidden, unknown, dropin or reset. A key named by a key-level forbidden rule is reported as forbidden, not unknown.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(exact|required|present|forbidden|unknown|dropin|reset):(Unit|Service|Install)\\.[A-Z][A-Za-z]+$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        },
        "oneOf": [
          {
            "properties": {
              "expect": {
                "const": "accept"
              },
              "violations": false
            }
          },
          {
            "properties": {
              "expect": {
                "const": "reject"
              },
              "violations": {
                "type": "array"
              }
            },
            "required": ["violations"]
          }
        ]
      }
    },
    "pae_vectors": {
      "const": "dsse/pae-vectors.json"
    },
    "signature_vectors": {
      "const": "dsse/signature-vectors.json"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[A-Za-z0-9._-]+)+$"
    }
  }
}
