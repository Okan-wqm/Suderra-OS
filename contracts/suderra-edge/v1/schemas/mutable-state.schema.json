{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:mutable-state",
  "title": "mutable-state.json read-only-root mutable-state table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "rootfs",
    "data_partition",
    "run_tmpfiles",
    "run_documents",
    "generic_profile",
    "image_files",
    "ownership_notes",
    "entries"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount",
        "etc_overlay",
        "var_overlay",
        "buildroot_remount_rootfs_rw",
        "etc_runtime_writes"
      ],
      "properties": {
        "mount": {
          "const": "dm-verity read-only"
        },
        "etc_overlay": {
          "const": false
        },
        "var_overlay": {
          "const": false
        },
        "buildroot_remount_rootfs_rw": {
          "const": false
        },
        "etc_runtime_writes": {
          "const": false
        }
      }
    },
    "data_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mount_point",
        "mount_options",
        "encryption",
        "layout_tmpfiles",
        "layout_applied_by"
      ],
      "properties": {
        "mount_point": {
          "const": "/data"
        },
        "mount_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["nosuid", "nodev", "noexec"]
          },
          "minItems": 3
        },
        "encryption": {
          "type": "string"
        },
        "layout_tmpfiles": {
          "const": "/usr/lib/suderra/data-layout.tmpfiles.conf"
        },
        "layout_applied_by": {
          "type": "string"
        }
      }
    },
    "run_tmpfiles": {
      "const": "/usr/lib/tmpfiles.d/suderra.conf"
    },
    "run_documents": {
      "description": "The documents at fixed run-time paths whose members and writer are part of the contract.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "writer", "readers", "rule"],
        "properties": {
          "path": { "type": "string", "pattern": "^/run/suderra/[A-Za-z0-9._/<>-]+$" },
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "format": { "type": "string" },
          "writer": { "enum": ["os-root", "agent"] },
          "readers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["os-root", "agent"] }
          },
          "rule": { "type": "string" }
        },
        "oneOf": [
          { "properties": { "schema": true }, "required": ["schema"] },
          { "properties": { "format": true }, "required": ["format"] }
        ]
      }
    },
    "generic_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "documents"],
      "properties": {
        "description": { "type": "string" },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "schema", "rule"],
            "properties": {
              "path": { "type": "string", "pattern": "^\\$DATA/[A-Za-z0-9._/-]+$" },
              "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
              "rule": { "type": "string" }
            }
          }
        }
      }
    },
    "image_files": {
      "description": "Read-only files of the verity rootfs that root and the agent read; none is written at run time.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "readers", "decisions"],
        "properties": {
          "path": { "type": "string", "pattern": "^/etc/[A-Za-z0-9._/<>-]+$" },
          "format": { "type": "string" },
          "readers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["os-root", "agent"] }
          },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^DEC-[0-9]+(\\.[0-9]+)?$" }
          }
        }
      }
    },
    "ownership_notes": {
      "description": "Where an implementer's report found the ownership wording ambiguous or wrong: the resolution, why it stays or changes, and which code must follow.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "decision", "why", "code"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "topic": { "type": "string" },
          "decision": { "type": "string" },
          "why": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "node", "backing", "writer", "agent_access", "contents", "decisions"],
        "properties": {
          "path": {
            "$ref": "#/$defs/abs_path"
          },
          "node": {
            "enum": ["directory", "file"]
          },
          "backing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": [
                  "data-bind",
                  "data-dir",
                  "data-layout-dir",
                  "tmpfs",
                  "tmpfs-bind",
                  "runtime-directory",
                  "rootfs-empty-file",
                  "rauc-window",
                  "unused"
                ]
              },
              "source": {
                "$ref": "#/$defs/abs_path"
              },
              "mount_options": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["ro", "nosuid", "nodev", "exec", "noexec"]
                }
              }
            }
          },
          "owner": {
            "$ref": "#/$defs/account"
          },
          "group": {
            "$ref": "#/$defs/account"
          },
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "file_mode": {
            "$ref": "#/$defs/mode"
          },
          "writer": {
            "enum": [
              "os-root",
              "os-root-installer",
              "agent",
              "chronyd",
              "rauc",
              "systemd",
              "suderra-provision-mode",
              "provision-forced-command",
              "none"
            ]
          },
          "agent_access": {
            "enum": ["none", "read", "read-only-bind", "read-write", "exec"]
          },
          "contents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^DEC-[0-9]+(\\.[0-9]+)?$"
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "backing": {
                "properties": {
                  "kind": {
                    "const": "unused"
                  }
                }
              },
              "writer": {
                "const": "none"
              },
              "agent_access": {
                "const": "none"
              },
              "owner": false,
              "group": false,
              "mode": false,
              "file_mode": false
            }
          },
          {
            "properties": {
              "backing": {
                "properties": {
                  "kind": {
                    "not": {
                      "const": "unused"
                    }
                  }
                }
              },
              "owner": true,
              "group": true,
              "mode": true
            },
            "required": ["owner", "group", "mode"]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "node": {
                  "const": "file"
                }
              }
            },
            "then": {
              "properties": {
                "file_mode": false
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "abs_path": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]*[A-Za-z0-9._-]$"
    },
    "account": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "mode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    }
  }
}
