{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:statements",
  "title": "statements.json statement registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "dsse",
    "verification_order",
    "rejection_reasons",
    "purposes",
    "os_key_pin_layout",
    "statements",
    "unsigned_documents"
  ],
  "properties": {
    "description": { "type": "string" },
    "dsse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_schema",
        "pae",
        "payload_encoding",
        "signed_bytes",
        "signature_algorithm",
        "signatures",
        "keyid",
        "json",
        "statement_digest",
        "time_window"
      ],
      "properties": {
        "envelope_schema": { "const": "schemas/dsse-envelope.schema.json" },
        "pae": { "type": "string" },
        "payload_encoding": { "type": "string" },
        "signed_bytes": { "type": "string" },
        "signature_algorithm": { "type": "string" },
        "signatures": { "type": "string" },
        "keyid": { "type": "string" },
        "json": { "type": "string" },
        "statement_digest": { "type": "string" },
        "time_window": { "type": "string" }
      }
    },
    "verification_order": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "$ref": "#/$defs/reason" }
    },
    "rejection_reasons": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reason" },
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "purposes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/purpose" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "anchored_in"],
        "properties": {
          "algorithm": { "enum": ["ed25519", "x509"] },
          "anchored_in": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["os-image", "trust-anchors-bundle"] }
          }
        }
      }
    },
    "os_key_pin_layout": { "type": "string" },
    "statements": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/statement_type" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload_type",
          "schema",
          "signing_purpose",
          "verified_by",
          "device_bound",
          "tenant_bound",
          "sequence",
          "checks"
        ],
        "properties": {
          "payload_type": {
            "type": "string",
            "pattern": "^application/vnd\\.suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*\\+json$"
          },
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "signing_purpose": { "$ref": "#/$defs/purpose" },
          "verified_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["os-root", "agent", "cloud"] }
          },
          "device_bound": { "type": "boolean" },
          "tenant_bound": { "type": "boolean" },
          "sequence": { "enum": [null, "update_seq", "bundle_seq"] },
          "checks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/reason" }
          }
        }
      }
    },
    "unsigned_documents": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/statement_type" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "written_by", "locations", "trust"],
        "properties": {
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "written_by": { "enum": ["os-root"] },
          "locations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "trust": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "reason": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "purpose": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "statement_type": { "type": "string", "pattern": "^suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*$" }
  }
}
