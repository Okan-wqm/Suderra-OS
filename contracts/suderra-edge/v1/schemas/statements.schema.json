{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suderra:edge-contract:v1:schema:statements",
  "title": "statements.json statement registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "dsse",
    "verification_order",
    "evaluation",
    "identity",
    "sequences",
    "reverification",
    "verifiers",
    "compatibility",
    "rejection_reasons",
    "purposes",
    "os_key_pin_layout",
    "statements",
    "planned_successors",
    "superseded_formats",
    "unsigned_documents"
  ],
  "properties": {
    "description": { "type": "string" },
    "dsse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_schema",
        "pae",
        "payload_encoding",
        "signed_bytes",
        "signature_algorithm",
        "signatures",
        "keyid",
        "key_resolution",
        "json",
        "statement_digest",
        "time_window"
      ],
      "properties": {
        "envelope_schema": { "const": "schemas/dsse-envelope.schema.json" },
        "pae": { "type": "string" },
        "payload_encoding": { "type": "string" },
        "signed_bytes": { "type": "string" },
        "signature_algorithm": { "type": "string" },
        "signatures": { "type": "string" },
        "keyid": { "type": "string" },
        "key_resolution": { "type": "string" },
        "json": { "type": "string" },
        "statement_digest": { "type": "string" },
        "time_window": { "type": "string" }
      }
    },
    "verification_order": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": { "$ref": "#/$defs/reason" }
    },
    "evaluation": { "type": "string" },
    "identity": { "type": "string" },
    "sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "equal_seq_policies"],
      "properties": {
        "description": { "type": "string" },
        "equal_seq_policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reject", "identical-only"],
          "properties": {
            "reject": { "type": "string" },
            "identical-only": { "type": "string" }
          }
        }
      }
    },
    "reverification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "applies_to", "skipped_checks", "added_checks"],
      "properties": {
        "description": { "type": "string" },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/statement_type" }
        },
        "skipped_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        },
        "added_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "verifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os-root", "agent"],
      "properties": {
        "os-root": { "type": "string" },
        "agent": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "os_release", "kernel_config", "rules"],
      "properties": {
        "description": { "type": "string" },
        "os_release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "keys"],
          "properties": {
            "path": { "const": "/etc/os-release" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["VERSION_ID", "SUDERRA_AGENT_ABI"],
              "properties": {
                "VERSION_ID": { "$ref": "#/$defs/os_release_key" },
                "SUDERRA_AGENT_ABI": { "$ref": "#/$defs/os_release_key" }
              }
            }
          }
        },
        "kernel_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "syntax", "line_pattern"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "syntax": { "type": "string" },
            "line_pattern": { "type": "string" }
          }
        },
        "rules": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/reason" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "rejection_reasons": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reason" },
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "purposes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/purpose" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "anchored_in"],
        "properties": {
          "algorithm": { "enum": ["ed25519", "x509"] },
          "anchored_in": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["os-image", "trust-anchors-bundle"] }
          }
        }
      }
    },
    "os_key_pin_layout": { "type": "string" },
    "statements": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/statement_type" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload_type",
          "schema",
          "signing_purpose",
          "verified_by",
          "device_bound",
          "tenant_bound",
          "sequence",
          "nested",
          "checks"
        ],
        "properties": {
          "payload_type": {
            "type": "string",
            "pattern": "^application/vnd\\.suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*\\+json$"
          },
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "signing_purpose": { "$ref": "#/$defs/purpose" },
          "verified_by": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os-root"],
            "properties": {
              "os-root": { "$ref": "#/$defs/verifier_scope" },
              "agent": { "$ref": "#/$defs/verifier_scope" }
            }
          },
          "device_bound": { "type": "boolean" },
          "tenant_bound": { "type": "boolean" },
          "sequence": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "equal_seq"],
                "properties": {
                  "field": { "enum": ["update_seq", "bundle_seq", "policy_version"] },
                  "equal_seq": { "enum": ["reject", "identical-only"] }
                }
              }
            ]
          },
          "nested": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/statement_type" }
          },
          "checks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/reason" }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "planned_successors": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/statement_type" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["successor", "phase", "adds", "ratchet", "v1_rule"],
        "properties": {
          "successor": { "$ref": "#/$defs/statement_type" },
          "phase": { "enum": ["P2", "P3"] },
          "adds": { "type": "string" },
          "ratchet": { "type": "string" },
          "v1_rule": { "type": "string" }
        }
      }
    },
    "superseded_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "unsigned_documents": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/statement_type" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "written_by",
          "locations",
          "trust",
          "reasons_by_kind",
          "operational_reasons"
        ],
        "properties": {
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$" },
          "written_by": { "enum": ["os-root"] },
          "locations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "trust": { "type": "string" },
          "reasons_by_kind": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/reason" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statements", "reverification", "operational"],
              "properties": {
                "statements": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/statement_type" }
                },
                "reverification": { "type": "boolean" },
                "operational": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/reason" }
                }
              }
            }
          },
          "operational_reasons": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/reason" },
            "additionalProperties": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  },
  "$defs": {
    "reason": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "purpose": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "statement_type": { "type": "string", "pattern": "^suderra\\.[a-z0-9-]+\\.v[1-9][0-9]*$" },
    "verifier_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omits"],
      "properties": {
        "omits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "os_release_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax", "pattern"],
      "properties": {
        "syntax": { "type": "string" },
        "pattern": { "type": "string" }
      }
    }
  }
}
