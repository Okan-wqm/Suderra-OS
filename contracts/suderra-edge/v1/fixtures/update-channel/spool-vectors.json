        },
        {
          "name": "17bb5d7ef7358b682a68439547f9162de6ad5d7cdd69327fe796d6576ee3b4b1.dsse",
          "size_bytes": 4096
        },
        {
          "name": ".b03d19113141eec97b0e38c5dccbba60d433a40f0687aef22f159c44a9a84b92.dsse.tmp-4242",
          "size_bytes": 4096
        }
      ],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 4096
      },
      "expect": "write",
      "note": "A dot-file of another process is removed first and does not count against the bound."
    }
  ]
}
