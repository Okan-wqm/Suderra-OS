      "pending": [],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 4096
      },
      "expect": "write",
      "note": "Nothing pending."
    },
    {
      "id": "three-pending",
      "pending": [
        {
          "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
          "size_bytes": 4096
        },
        {
          "name": "c73528735a3b8fd8a1cd68ca760e2c476e9a0a9bda90c9244a4fcaa5dd0a0b3a.dsse",
          "size_bytes": 4096
        },
        {
          "name": "17bb5d7ef7358b682a68439547f9162de6ad5d7cdd69327fe796d6576ee3b4b1.dsse",
          "size_bytes": 4096
        }
      ],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 4096
      },
      "expect": "write",
      "note": "One below max_pending_entries."
    },
    {
      "id": "four-pending",
      "pending": [
        {
          "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
          "size_bytes": 4096
        },
        {
          "name": "c73528735a3b8fd8a1cd68ca760e2c476e9a0a9bda90c9244a4fcaa5dd0a0b3a.dsse",
          "size_bytes": 4096
        },
        {
          "name": "17bb5d7ef7358b682a68439547f9162de6ad5d7cdd69327fe796d6576ee3b4b1.dsse",
          "size_bytes": 4096
        },
        {
          "name": "a67e133324a0a6babd9a3ca288ea32c7b6b7c3286b9638612102537ac4110ae5.dsse",
          "size_bytes": 4096
        }
      ],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 4096
      },
      "expect": "refuse",
      "reason": "update-requests-backlog",
      "note": "max_pending_entries reached: nothing is written until root consumed one."
    },
    {
      "id": "four-pending-same-name",
      "pending": [
        {
          "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
          "size_bytes": 4096
        },
        {
          "name": "c73528735a3b8fd8a1cd68ca760e2c476e9a0a9bda90c9244a4fcaa5dd0a0b3a.dsse",
          "size_bytes": 4096
        },
        {
          "name": "17bb5d7ef7358b682a68439547f9162de6ad5d7cdd69327fe796d6576ee3b4b1.dsse",
          "size_bytes": 4096
        },
        {
          "name": "a67e133324a0a6babd9a3ca288ea32c7b6b7c3286b9638612102537ac4110ae5.dsse",
          "size_bytes": 4096
        }
      ],
      "request": {
        "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
        "size_bytes": 4096
      },
      "expect": "write",
      "note": "A request for a statement already in the directory replaces it and is never counted twice."
    },
    {
      "id": "bytes-over-limit",
      "pending": [
        {
          "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
          "size_bytes": 200000
        }
      ],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 65536
      },
      "expect": "refuse",
      "reason": "update-requests-backlog",
      "note": "One pending entry of 200000 bytes and a request of max_entry_bytes: 265536 bytes exceed max_pending_bytes (262144), although only one entry is pending."
    },
    {
      "id": "bytes-at-limit",
      "pending": [
        {
          "name": "f10e9dec5fa76c89ba2f78cae5a3e028a375630b2165a330de5ff4c7591a067d.dsse",
          "size_bytes": 65536
        },
        {
          "name": "c73528735a3b8fd8a1cd68ca760e2c476e9a0a9bda90c9244a4fcaa5dd0a0b3a.dsse",
          "size_bytes": 65536
        },
        {
          "name": "17bb5d7ef7358b682a68439547f9162de6ad5d7cdd69327fe796d6576ee3b4b1.dsse",
          "size_bytes": 65536
        }
      ],
      "request": {
        "name": "e98b5c780aa51f16926cee748827c82cbc0f8dbef74bafcd3183425fbd068181.dsse",
        "size_bytes": 65536
      },
      "expect": "write",
      "note": "Three full entries and a fourth of max_entry_bytes: exactly max_pending_bytes, allowed."
