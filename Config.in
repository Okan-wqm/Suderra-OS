#
# Suderra OS — BR2_EXTERNAL Kconfig giriş noktası
#
# Bu dosya `make menuconfig` çalıştırıldığında "External options"
# menüsünde Suderra OS-özel seçeneklerini ortaya çıkarır.
#
# Buildroot manuel:
#   https://buildroot.org/downloads/manual/manual.html#outside-br-custom
#

menu "Suderra OS"

config BR2_EXTERNAL_SUDERRA_PATH
	string
	default "$(BR2_EXTERNAL_SUDERRA_PATH)"

#
# Custom paketler — package/<name>/Config.in dosyaları
#
source "$BR2_EXTERNAL_SUDERRA_PATH/package/suderra-firstboot/Config.in"
source "$BR2_EXTERNAL_SUDERRA_PATH/package/suderra-os-installer/Config.in"
source "$BR2_EXTERNAL_SUDERRA_PATH/package/suderra-keys/Config.in"
source "$BR2_EXTERNAL_SUDERRA_PATH/package/suderra-rauc-config/Config.in"
source "$BR2_EXTERNAL_SUDERRA_PATH/package/suderra-ota/Config.in"
source "$BR2_EXTERNAL_SUDERRA_PATH/package/revpi-picontrol/Config.in"

#
# /data volume tools. suderra-data-unlock ships in every image's rootfs
# overlay (board/suderra/common/rootfs-overlay/usr/sbin) and creates the ext4
# filesystem of a freshly provisioned /data with mkfs.ext4; an ext4 /data and
# the ext4 root also need e2fsck. No image selected e2fsprogs, so the first
# boot died at mkfs.ext4 after the LUKS volume was formatted and TPM-sealed
# (EI-078). The overlay is common to all images, so its tools are selected
# here once, by an option nobody can switch off, instead of by each defconfig.
# scripts/ci/check-target-commands.py proves at build time that every command
# the shipped scripts run exists in the image.
#
config BR2_PACKAGE_SUDERRA_DATA_TOOLS
	bool
	default y
	depends on BR2_USE_MMU # e2fsprogs
	select BR2_PACKAGE_E2FSPROGS
	# The recovery key of the LUKS /data is escrowed with openssl (DEC-14.3).
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBOPENSSL_BIN

#
# Profil seçimi — hangi varyant build ediliyor
#
choice
	prompt "Suderra OS variant"
	default BR2_PACKAGE_SUDERRA_VARIANT_DEV

config BR2_PACKAGE_SUDERRA_VARIANT_DEV
	bool "Development / diagnostics (not for appliance release)"
	help
	  Sadece kontrollü geliştirme ve QEMU/lab doğrulaması için.
	  Production'da KULLANMA.

config BR2_PACKAGE_SUDERRA_VARIANT_PROD
	bool "Production appliance (locked runtime, provisioning by lifecycle state)"
	help
	  Üretim varyantı kilitli runtime imajıdır. Getty ve debug shell
	  bu imajda açık gelmez. Provisioning bir imaj varyantı değil,
	  /data'ya bağlı bir boot durumudur (ADR-048 DEC-5.1): Dropbear
	  ve provisioning birimleri imajdadır ama yalnız root-owned yaşam
	  döngüsü PROVISIONING (veya yeniden provisioning amaçlı
	  MAINTENANCE) iken, /run'daki tek-kullanımlık parolayla ve
	  varsayılan rota arayüzüyle sınırlı açılır; kayıttan sonra
	  kapanır.
	  dm-verity, secure boot, imzalı release, RAUC ve hardware evidence
	  üretim kapılarıdır.

endchoice

#
# Versiyon bilgisi (os-release dosyasına yazılır)
#
config BR2_PACKAGE_SUDERRA_VERSION
	string "Suderra OS version string"
	default "v0.1.0-alpha"

config BR2_PACKAGE_SUDERRA_BUILD_ID
	string "Build identifier (CI/CD pipeline'dan gelir)"
	default "local-dev"

endmenu
