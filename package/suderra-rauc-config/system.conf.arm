# compatible is a per-board image fact (ADR-048 DEC-8.3, boards.json
# rauc_compatible): post-build.sh replaces the placeholder with the OTA target
# contract's compatible for the image (ci/evidence-contract.yml), checks that
# it equals the board's boards.json value, and fails the build if it is left.
[system]
compatible=@SUDERRA_RAUC_COMPATIBLE@
bootloader=uboot
# The boot counters of the A/B choice in U-Boot's compiled-in bootcmd
# (board/suderra/uboot/suderra.env). Every boot of a slot spends one try and
# saves it before the kernel starts; RAUC's mark-good arms the booted slot again
# with boot-attempts tries, and a freshly installed slot starts with
# boot-attempts-primary. A slot that never reaches mark-good therefore runs out
# of tries and the other slot boots - a new slot that panics, or one whose
# dm-verity restarts the machine (restart_on_corruption) - and a board whose
# slots are all out arms them again. boot-attempts is U-Boot's
# suderra_attempts, the tries that re-arm gives; boot-attempts-primary may not
# exceed it (tests/image-contracts/arm-rauc-config-contract-test.sh holds both
# to the environment).
boot-attempts=3
boot-attempts-primary=3
bundle-formats=verity
statusfile=/data/rauc/status.ini

[keyring]
path=/etc/rauc/keyring.pem

# ARM boot zinciri imzalı FIT'e dayanır: slot-post-install hook (PR-A5)
# suderra-<bootname>.fit'i /boot FAT bölümüne kopyalar (rw only for that copy);
# U-Boot's compiled-in bootcmd chooses the slot from BOOT_ORDER/BOOT_<slot>_LEFT,
# which fw_setenv writes to the raw environment (fw_env.config).
[handlers]
post-install=/usr/lib/rauc/suderra-rauc-arm-slot-hook.sh

# The slots are named by suderra-disk-layout (/run/suderra-os/disk/<partition>),
# which proves that each partition is carried once and lives on the disk under
# the verified root (ADR-048 DEC-18.1): RAUC never writes an image to a device
# that only claims a PARTUUID. rauc.service waits for it (rauc.service.d).
[slot.rootfs.0]
device=/run/suderra-os/disk/rootfs-a
type=raw
bootname=A

[slot.rootfs-verity.0]
device=/run/suderra-os/disk/rootfs-a-verity
type=raw
parent=rootfs.0

[slot.rootfs.1]
device=/run/suderra-os/disk/rootfs-b
type=raw
bootname=B

[slot.rootfs-verity.1]
device=/run/suderra-os/disk/rootfs-b-verity
type=raw
parent=rootfs.1
